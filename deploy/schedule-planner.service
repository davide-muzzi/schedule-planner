[Unit]
Description=Schedule Planner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# This is a template - replace every <PLACEHOLDER> below with your actual
# values *after* copying this file onto the Pi (e.g. into
# /etc/systemd/system/schedule-planner.service). Don't fill these in here -
# this file is tracked in a public repo.
User=<PI_USERNAME>
WorkingDirectory=/home/<PI_USERNAME>/schedule-planner-publish
# Installed via dotnet-install.sh, not apt, so dotnet lives under the
# user's home directory rather than /usr/bin.
ExecStart=/home/<PI_USERNAME>/.dotnet/dotnet /home/<PI_USERNAME>/schedule-planner-publish/SchedulePlanner.dll

Restart=on-failure
RestartSec=5

Environment=ASPNETCORE_ENVIRONMENT=Production
# Binds only to the Pi's Tailscale address - not reachable from your home
# WiFi, only from devices authorized on your tailnet. Find this in the
# Tailscale admin console (login.tailscale.com/admin/machines).
Environment=ASPNETCORE_URLS=http://<PI_TAILSCALE_IP>:5000

# Seeds the one account this app will ever have, the first time it starts
# with an empty AspNetUsers table. No-op on every startup after that - there
# is no registration page, so this is the only way to create the account.
# Pick your own username/password here; don't reuse a password from
# elsewhere.
Environment=ADMIN_USERNAME=<CHOOSE_A_USERNAME>
Environment=ADMIN_PASSWORD=<CHOOSE_A_PASSWORD>

[Install]
WantedBy=multi-user.target
